model InventoryShipment {
  id                    Int            @id @default(autoincrement())
  productId             Int            @map("product_id")
  supplier              String?
  quantity              Int
  unitCost              Decimal        @default(0) @map("unit_cost") @db.Decimal(19, 4)
  shippingCost          Decimal        @default(0) @map("shipping_cost") @db.Decimal(19, 4)
  customsDuties         Decimal        @default(0) @map("customs_duties") @db.Decimal(19, 4)
  otherCosts            Decimal        @default(0) @map("other_costs") @db.Decimal(19, 4)
  totalCost             Decimal        @default(0) @map("total_cost") @db.Decimal(19, 4)
  status                ShipmentStatus @default(pending)
  expectedArrivalDate   DateTime?      @map("expected_arrival_date")
  arrivedAt             DateTime?      @map("arrived_at")
  glJournalEntryId      Int?           @map("gl_journal_entry_id")
  notes                 String?
  createdById           Int            @map("created_by_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  // F-605: the cost columns above are in `currency`; null reads as the store currency.
  currency              String?        @db.VarChar(3)
  fxRate                Decimal?       @map("fx_rate") @db.Decimal(19, 8)
  fxRateSource          FxSource?      @map("fx_rate_source")
  // F-606 / F-611: set when the shipment is received. landedCostPerUnit = totalCostStore / quantityCounted.
  totalCostStore        Decimal?       @map("total_cost_store") @db.Decimal(19, 4)
  landedCostPerUnit     Decimal?       @map("landed_cost_per_unit") @db.Decimal(19, 4)
  receivedAt            DateTime?      @map("received_at")
  receivedById          Int?           @map("received_by_id")
  quantityCounted       Int?           @map("quantity_counted")
  shortQuantity         Int?           @map("short_quantity")
  destinationLocationId Int?           @map("destination_location_id")
  // F-608: supplier claim for the short units.
  claimStatus           ClaimStatus    @default(none) @map("claim_status")
  claimAmount           Decimal        @default(0) @map("claim_amount") @db.Decimal(19, 4)
  claimRecovered        Decimal?       @map("claim_recovered") @db.Decimal(19, 4)
  claimNote             String?        @map("claim_note")
  // Entry posted when a claim is settled (DR 1010 / CR 1200 for the amount recovered).
  claimJournalEntryId   Int?           @map("claim_journal_entry_id")

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy           User                @relation("ShipmentCreator", fields: [createdById], references: [id])
  receivedBy          User?               @relation("ShipmentReceiver", fields: [receivedById], references: [id])
  glJournalEntry      JournalEntry?       @relation(fields: [glJournalEntryId], references: [id])
  claimJournalEntry   JournalEntry?       @relation("ShipmentClaimEntry", fields: [claimJournalEntryId], references: [id])
  destinationLocation StockLocation?      @relation("ShipmentDestination", fields: [destinationLocationId], references: [id])
  inventoryTransfers  InventoryTransfer[]
  stockCounts         StockCount[]
  tenantId            String?             @map("tenant_id")
  tenant              Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([status])
  @@index([expectedArrivalDate])
  @@index([tenantId])
  @@index([receivedById])
  @@index([destinationLocationId])
  @@index([claimJournalEntryId])
  @@map("inventory_shipments")
}

// `arrived` is the old name of `received`. Old rows keep it and old code still reads it until M4-T12 moves to `received`.
enum ShipmentStatus {
  pending
  arrived
  received
}

enum ClaimStatus {
  none
  open
  settled
  written_off
}

