/// A checkout that initialized a Paystack transaction but hasn't been paid yet.
/// Paystack orders are NOT created at checkout — only after payment is confirmed
/// (webhook or callback verify). This holds the fully-computed order snapshot
/// keyed by the Paystack reference so settlement can materialize the real Order.
/// Abandoned/failed checkouts never become Orders; stale rows are swept by the
/// pending-checkout cleanup cron. customerId/tenantId are plain scalars (no FK)
/// since the row is transient.
model PendingCheckout {
  id                  Int       @id @default(autoincrement())
  reference           String    @unique
  tenantId            String    @map("tenant_id")
  customerId          Int       @map("customer_id")
  formId              Int       @map("form_id")
  paymentMethod       String    @map("payment_method")
  orderType           String    @map("order_type")
  currency            String
  subtotal            Decimal   @db.Decimal(19, 4)
  shippingCost        Decimal   @default(0) @map("shipping_cost") @db.Decimal(19, 4)
  discount            Decimal   @default(0) @db.Decimal(19, 4)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(19, 4)
  codAmount           Decimal?  @map("cod_amount") @db.Decimal(19, 4)
  balanceDue          Decimal   @default(0) @map("balance_due") @db.Decimal(19, 4)
  paystackChargeMinor Int       @map("paystack_charge_minor")
  orderItems          Json      @map("order_items")
  formData            Json      @map("form_data")
  selectedPackage     Json      @map("selected_package")
  selectedUpsells     Json?     @map("selected_upsells")
  ipAddress           String?   @map("ip_address")
  userAgent           String?   @map("user_agent")
  // Meta click identifiers, carried from checkout through to the Order created at
  // settlement so the Paystack Purchase CAPI event gets the same match keys as COD.
  fbp                 String?   @map("fbp")
  fbc                 String?   @map("fbc")
  // Provider that holds the payment (F-400). Settlement picks the adapter from it.
  provider            String    @default("paystack")
  // initiated | pending | failed | expired | needs_review (F-404)
  status              String    @default("initiated")
  lastCheckedAt       DateTime? @map("last_checked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([tenantId, status, createdAt])
  @@map("pending_checkouts")
}

