  children    Target[]    @relation("TargetHierarchy")
  user        User?       @relation("TargetUser", fields: [userId], references: [id], onDelete: SetNull)
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([tenantId, scope, periodStart])
  @@map("targets")
}

/// Minimal shape from M1; extended in M5/M6. Money or stock gaps found by the nightly jobs (F-905).
/// subjectId is text because subjects are not all integer rows (a ledger gap is a day, a cash gap a partner).
model Finding {
  id              Int              @id @default(autoincrement())
  type            FindingType
  status          FindingStatus    @default(open)
  subjectType     String           @map("subject_type")
  subjectId       String           @map("subject_id")
  amount          Decimal?         @db.Decimal(19, 4)
  note            String?
  createdAt       DateTime         @default(now()) @map("created_at")
  tenantId        String           @map("tenant_id")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stockCountLines StockCountLine[]

  @@index([tenantId])
  @@index([tenantId, type, status])
  @@index([tenantId, type, subjectType, subjectId])
  @@map("findings")
}

/// Minimal shape from M1; extended in M5/M6. Fee a delivery partner keeps per outcome (F-935, F-936). No rule means fee 0.
model FeeRule {
  id            Int        @id @default(autoincrement())
  partnerUserId Int        @map("partner_user_id")
  outcome       FeeOutcome
  amount        Decimal    @db.Decimal(19, 4)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  partner       User       @relation("FeeRulePartner", fields: [partnerUserId], references: [id], onDelete: Cascade)
  tenantId      String     @map("tenant_id")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, partnerUserId, outcome])
  @@index([tenantId])
  @@map("fee_rules")
}

/// Minimal shape from M1; extended in M5/M6. Per-day FX rate history (F-1232).
/// source is in the unique key so a manual override and the automatic rate of the same day both stay stored (manual wins on lookup; "use today's rate" ends the override).
model FxRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @map("from_currency") @db.VarChar(3)
  toCurrency   String   @map("to_currency") @db.VarChar(3)
  rate         Decimal  @db.Decimal(19, 8)
  date         DateTime @db.Date
  source       FxSource
  createdById  Int?     @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    User?    @relation("FxRateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, fromCurrency, toCurrency, date, source])
  @@index([tenantId])
  @@map("fx_rates")
}

/// M2-T01: minimal shape. M6 adds fields, UI and the permission matrix (F-1150).
model Role {
  id          Int              @id @default(autoincrement())
  tenantId    String           @map("tenant_id")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name        String
  area        String?
  contract    Json?
  tools       Json?
  kpis        Json?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  assignments RoleAssignment[]
  mcpApiKeys  McpApiKey[]
  auditLogs   AuditLog[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RoleAssignment {
  id        Int       @id @default(autoincrement())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roleId    Int       @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  holderId  Int       @map("holder_id")
  holder    User      @relation("RoleAssignmentHolder", fields: [holderId], references: [id], onDelete: Cascade)
  fromDate  DateTime  @map("from_date") @db.Date
  toDate    DateTime? @map("to_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([roleId])
  @@index([holderId])
  @@map("role_assignments")
}

// One row per login (F-1224). tokenHash is the hash of the refresh token; the raw token is never stored.
model UserSession {
  id          Int      @id @default(autoincrement())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @map("token_hash")
  deviceLabel String?  @map("device_label")
  ip          String?
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tokenHash])
  @@index([tenantId])
  @@index([userId])
  @@map("user_sessions")
}

// One payment-provider account per tenant and provider (F-400). The secret key is stored
// encrypted (enc:v1:) and masked on read.
model PaymentConnection {
  id                  Int       @id @default(autoincrement())
  tenantId            String    @map("tenant_id")
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  provider            String
  mode                String    @default("test")
  publicKey           String?   @map("public_key")
  secretKey           String?   @map("secret_key")
  isEnabled           Boolean   @default(true) @map("is_enabled")
  supportedCurrencies String[]  @default([]) @map("supported_currencies")
  lastCheckedAt       DateTime? @map("last_checked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("payment_connections")
}
