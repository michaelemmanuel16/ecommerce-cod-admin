/// A count of stock at one location against our records (F-653).
model StockCount {
  id          Int                @id @default(autoincrement())
  locationId  Int                @map("location_id")
  countDate   DateTime           @map("count_date") @db.Date
  source      StockCountSource
  countedById Int                @map("counted_by_id")
