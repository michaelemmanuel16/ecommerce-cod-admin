// One row per stock movement (F-651). fromAgentId and toAgentId are for old rows only; new rows use the location columns.
model InventoryTransfer {
  id               Int             @id @default(autoincrement())
  productId        Int             @map("product_id")
  quantity         Int
  transferType     TransferType    @map("transfer_type")
  fromAgentId      Int?            @map("from_agent_id")
  toAgentId        Int?            @map("to_agent_id")
  orderId          Int?            @map("order_id")
  notes            String?
  createdById      Int             @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  tenantId         String?         @map("tenant_id")
  fromLocationId   Int?            @map("from_location_id")
  toLocationId     Int?            @map("to_location_id")
  shipmentId       Int?            @map("shipment_id")
  // Old rows are finished moves, so they read as received.
  status           TransferStatus  @default(received)
  receivedQuantity Int?            @map("received_quantity")
  receivedAt       DateTime?       @map("received_at")
  receivedById     Int?            @map("received_by_id")
  reason           TransferReason?
  reversedAt       DateTime?       @map("reversed_at")
  // Identifies one order line, so one order line takes stock out once. Written by stockService (M4-T07).
  // The partial unique index on (order_id, product_id, item_key) for active order_fulfillment rows is raw SQL in the migration; Prisma cannot express it.
  itemKey          String?         @map("item_key")

  product           Product            @relation(fields: [productId], references: [id])
  fromAgent         User?              @relation("TransferFrom", fields: [fromAgentId], references: [id])
  toAgent           User?              @relation("TransferTo", fields: [toAgentId], references: [id])
  order             Order?             @relation(fields: [orderId], references: [id])
  createdBy         User               @relation("TransferCreator", fields: [createdById], references: [id])
  receivedBy        User?              @relation("TransferReceiver", fields: [receivedById], references: [id])
  fromLocation      StockLocation?     @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation        StockLocation?     @relation("TransferToLocation", fields: [toLocationId], references: [id])
  shipment          InventoryShipment? @relation(fields: [shipmentId], references: [id])
  appliedCountLines StockCountLine[]
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([fromAgentId])
  @@index([toAgentId])
  @@index([transferType])
  @@index([createdAt])
  @@index([orderId])
  @@index([tenantId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([shipmentId])
  @@index([receivedById])
  @@index([tenantId, status])
  @@map("inventory_transfers")
}

