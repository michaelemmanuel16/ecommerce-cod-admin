generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                        String    @id @default(uuid())
  name                      String
  slug                      String    @unique
  logo                      String?
  region                    String?
  currency                  String    @default("GHS")
  currentPlanId             String?   @map("current_plan_id")
  subscriptionStatus        String    @default("active") @map("subscription_status")
  trialEndsAt               DateTime? @map("trial_ends_at")
  // MAN-61: SaaS subscription billing (CodAdmin-as-merchant on its platform Paystack account)
  paystackAuthorizationCode String?   @map("paystack_authorization_code")
  paystackCustomerCode      String?   @map("paystack_customer_code")
  paystackSubscriptionCode  String?   @map("paystack_subscription_code")
  subscriptionRenewsAt      DateTime? @map("subscription_renews_at")
  paymentFailedAt           DateTime? @map("payment_failed_at")
  paystackCardLast4         String?   @map("paystack_card_last4")
  freeAccessExpiresAt       DateTime? @map("free_access_expires_at")
  rateLimitEnabled          Boolean   @default(false) @map("rate_limit_enabled")
  rateLimitConfig           Json?     @map("rate_limit_config")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  currentPlan Plan? @relation(fields: [currentPlanId], references: [id])

  // Reverse relations for tenant-scoped models
  users                   User[]
  customers               Customer[]
  products                Product[]
  orders                  Order[]
  deliveries              Delivery[]
  transactions            Transaction[]
  expenses                Expense[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  accountTransactions     AccountTransaction[]
  workflows               Workflow[]
  workflowExecutions      WorkflowExecution[]
  webhookConfigs          WebhookConfig[]
  notifications           Notification[]
  checkoutForms           CheckoutForm[]
  inventoryShipments      InventoryShipment[]
  agentBalances           AgentBalance[]
  inventoryTransfers      InventoryTransfer[]
  agentStocks             AgentStock[]
  stockLocations          StockLocation[]
  stockLevels             StockLevel[]
  stockCounts             StockCount[]
  stockCountLines         StockCountLine[]
  deliveryPartnerProfiles DeliveryPartnerProfile[]
  deliveryAttempts        DeliveryAttempt[]
  messageLogs             MessageLog[]
  systemConfigs           SystemConfig[]
  mcpApiKeys              McpApiKey[]
  roles                   Role[]
  roleAssignments         RoleAssignment[]
  userSessions            UserSession[]
  paymentConnections      PaymentConnection[]
  webhookEvents           WebhookEvent[]
  emailTemplates          EmailTemplate[]
  emailCampaigns          EmailCampaign[]
  agentCollections        AgentCollection[]
  agentDeposits           AgentDeposit[]
  agentAgingBuckets       AgentAgingBucket[]
  payouts                 Payout[]
  calls                   Call[]
  orderHistories          OrderHistory[]
  auditLogs               AuditLog[]
  webhookLogs             WebhookLog[]
  smsTemplates            SmsTemplate[]
  downloadTokens          DownloadToken[]
  formSubmissions         FormSubmission[]
  productCostEntries      product_cost_entries[]
  targets                 Target[]
  findings                Finding[]
  feeRules                FeeRule[]
  fxRates                 FxRate[]

  @@index([paystackCustomerCode])
  @@index([paystackSubscriptionCode])
  @@map("tenants")
}

model Plan {
  id               String   @id @default(uuid())
  name             String   @unique
  displayName      String   @map("display_name")
  maxOrders        Int?     @map("max_orders")
  maxUsers         Int?     @map("max_users")
  priceGHS         Decimal  @map("price_ghs") @db.Decimal(10, 2)
  priceNGN         Decimal? @map("price_ngn") @db.Decimal(10, 2)
  paystackPlanCode String?  @map("paystack_plan_code")
  features         Json     @default("{}")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  tenants Tenant[]

  @@map("plans")
}

model PlatformAnnouncement {
  id        String    @id @default(uuid())
  title     String
  body      String
  type      String    @default("info")
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdBy Int?      @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("platform_announcements")
}

model User {
  id                    Int                     @id @default(autoincrement())
  email                 String                  @unique
  password              String
  phoneNumber           String?                 @map("phone_number")
  role                  UserRole
  isActive              Boolean                 @default(true) @map("is_active")
  isPlatformAdmin       Boolean                 @default(false) @map("is_platform_admin")
  isAvailable           Boolean                 @default(true) @map("is_available")
  lastLogin             DateTime?               @map("last_login")
  refreshToken          String?                 @map("refresh_token")
  passwordResetToken    String?                 @unique @map("password_reset_token")
  passwordResetExpires  DateTime?               @map("password_reset_expires")
  commissionAmount      Decimal?                @default(0) @map("commission_amount") @db.Decimal(19, 4) /// Fixed commission amount per delivery (GHS)
  country               String?
  preferences           Json?
  vehicleType           String?                 @map("vehicle_type")
  vehicleId             String?                 @map("vehicle_id")
  deliveryRate          Float?                  @default(0) @map("delivery_rate")
  totalEarnings         Decimal?                @default(0) @map("total_earnings") @db.Decimal(19, 4)
  totalCollected        Decimal                 @default(0) @map("total_collected") @db.Decimal(19, 4)
  location              String?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  firstName             String                  @map("first_name")
  lastName              String                  @map("last_name")
  displayName           String?                 @map("display_name")
  photoUrl              String?                 @map("photo_url")
  calls                 Call[]                  @relation("CallSalesRep")
  deliveries            Delivery[]
  expenses              Expense[]
  notifications         Notification[]
  createdOrders         Order[]                 @relation("OrderCreatedBy")
  assignedOrdersAsRep   Order[]                 @relation("OrderCustomerRep")
  assignedOrdersAsAgent Order[]                 @relation("OrderDeliveryAgent")
  payouts               Payout[]
  auditLogs             AuditLog[]
  journalEntriesCreated JournalEntry[]          @relation("JournalEntryCreator")
  journalEntriesVoided  JournalEntry[]          @relation("VoidedByUser")
  collections           AgentCollection[]       @relation("AgentCollections")
  verifiedCollections   AgentCollection[]       @relation("VerifiedCollections")
  approvedCollections   AgentCollection[]       @relation("ApprovedCollections")
  balance               AgentBalance?
  deposits              AgentDeposit[]          @relation("AgentDeposits")
  verifiedDeposits      AgentDeposit[]          @relation("VerifiedDeposits")
  agingBucket           AgentAgingBucket?
  blockedBalances       AgentBalance[]          @relation("BlockedBy")
  agentStock            AgentStock[]            @relation("AgentStockHoldings")
  transfersFrom         InventoryTransfer[]     @relation("TransferFrom")
  transfersTo           InventoryTransfer[]     @relation("TransferTo")
  transfersCreated      InventoryTransfer[]     @relation("TransferCreator")
  shipmentsCreated      InventoryShipment[]     @relation("ShipmentCreator")
  shipmentsReceived     InventoryShipment[]     @relation("ShipmentReceiver")
  transfersReceived     InventoryTransfer[]     @relation("TransferReceiver")
  stockLocations        StockLocation[]         @relation("StockLocationHolder")
  stockCountsMade       StockCount[]            @relation("StockCountCounter")
  partnerProfile        DeliveryPartnerProfile? @relation("PartnerProfileUser")
  deliveryAttempts      DeliveryAttempt[]       @relation("DeliveryAttemptPartner")
  confirmedOrders       Order[]                 @relation("OrderConfirmedBy")
  targetsAsOwner        Target[]                @relation("TargetUser")
  feeRules              FeeRule[]               @relation("FeeRulePartner")
  fxRatesCreated        FxRate[]                @relation("FxRateCreator")
  kind                  UserKind                @default(person)
  roleAssignments       RoleAssignment[]        @relation("RoleAssignmentHolder")
  sessions              UserSession[]
  customersCreated      Customer[]              @relation("CustomerCreatedBy")
  mcpApiKeys            McpApiKey[]             @relation("McpApiKeyUser")
  tenantId              String?                 @map("tenant_id")
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([role, isActive])
  @@index([role, isActive, isAvailable])
  @@index([tenantId])
  @@map("users")
}

model Customer {
  id               Int          @id @default(autoincrement())
  email            String?
  phoneNumber      String       @map("phone_number")
  alternatePhone   String?      @map("alternate_phone")
  address          String
  state            String
  area             String
  landmark         String?
  tags             String[]     @default([])
  notes            String?
  totalOrders      Int          @default(0) @map("total_orders")
  totalSpent       Decimal      @default(0) @map("total_spent") @db.Decimal(19, 4)
  // Stored stats (F-357). customerStatsService.recompute rebuilds them from orders.
  deliveredOrders  Int          @default(0) @map("delivered_orders")
  refusedOrders    Int          @default(0) @map("refused_orders")
  deliveredValue   Decimal      @default(0) @map("delivered_value") @db.Decimal(19, 4)
  lastOrderAt      DateTime?    @map("last_order_at")
  createdById      Int?         @map("created_by_id")
  isActive         Boolean      @default(true) @map("is_active")
  smsOptOut        Boolean      @default(false) @map("sms_opt_out")
  whatsappOptOut   Boolean      @default(false) @map("whatsapp_opt_out")
  emailOptOut      Boolean      @default(false) @map("email_opt_out")
  // Stored 32-byte random hex (not signed, not derived from id); generated lazily before marketing sends.
  unsubscribeToken String?      @unique @map("unsubscribe_token")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  calls            Call[]
  orders           Order[]
  messageLogs      MessageLog[]
  tenantId         String?      @map("tenant_id")
  tenant           Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy        User?        @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([phoneNumber, tenantId], map: "customers_phone_number_tenant_key")
  @@index([isActive])
  @@index([email])
  @@index([area])
  @@index([totalSpent])
  @@index([tenantId])
  @@index([tenantId, area])
  @@index([tenantId, refusedOrders])
  @@map("customers")
}

model Product {
  id                      Int                    @id @default(autoincrement())
  sku                     String
  name                    String
  description             String?
  category                String
  price                   Decimal                @db.Decimal(19, 4)
  stockQuantity           Int                    @map("stock_quantity")
  lowStockThreshold       Int                    @default(10) @map("low_stock_threshold")
  // Days of cover that count as low stock (F-601). Null reads as the default.
  lowStockDays            Int?                   @map("low_stock_days")
  imageUrl                String?                @map("image_url")
  weight                  Float?
  dimensions              Json?
  isActive                Boolean                @default(true) @map("is_active")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  batch_quantity          Int                    @default(1)
  cogs                    Decimal?               @default(0) @db.Decimal(19, 4)
  productType             String                 @default("physical") @map("product_type")
  digitalFileUrl          String?                @map("digital_file_url")
  digitalFileType         String?                @map("digital_file_type")
  downloadLinkExpiryHours Int?                   @default(72) @map("download_link_expiry_hours")
  maxDownloads            Int?                   @map("max_downloads")
  checkoutForms           CheckoutForm[]
  formUpsells             FormUpsell[]
  orderItems              OrderItem[]
  product_cost_entries    product_cost_entries[]
  webhookConfigs          WebhookConfig[]
  agentStock              AgentStock[]
  inventoryTransfers      InventoryTransfer[]
  inventoryShipments      InventoryShipment[]
  stockLevels             StockLevel[]
  stockCountLines         StockCountLine[]
  tenantId                String?                @map("tenant_id")
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, sku])
  @@index([isActive])
  @@index([category, isActive])
  @@index([stockQuantity])
  @@index([productType])
  @@index([tenantId])
  @@map("products")
}

model Order {
  id                 Int                 @id @default(autoincrement())
  customerId         Int                 @map("customer_id")
  customerRepId      Int?                @map("customer_rep_id")
  deliveryAgentId    Int?                @map("delivery_agent_id")
  status             OrderStatus         @default(pending_confirmation)
  paymentStatus      PaymentStatus       @default(pending) @map("payment_status")
  subtotal           Decimal             @db.Decimal(19, 4)
  shippingCost       Decimal             @default(0) @map("shipping_cost") @db.Decimal(19, 4)
  discount           Decimal             @default(0) @db.Decimal(19, 4)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(19, 4)
  // Currency the amounts above were entered in (M1-T31). The DB trigger orders_set_currency fills it from
  // Tenant.currency on insert; null on an old row reads as the store currency. Never rewritten on a store currency change.
  currency           String?             @db.VarChar(3)
  codAmount          Decimal?            @map("cod_amount") @db.Decimal(19, 4)
  notes              String?
  internalNotes      String?             @map("internal_notes")
  orderType          String              @default("physical") @map("order_type")
  paymentMethod      String              @default("cod") @map("payment_method")
  paymentReference   String?             @map("payment_reference")
  paymentProvider    String?             @map("payment_provider")
  depositPaid        Decimal             @default(0) @map("deposit_paid") @db.Decimal(19, 4)
  balanceDue         Decimal             @default(0) @map("balance_due") @db.Decimal(19, 4)
  capiEventFired     Boolean             @default(false) @map("capi_event_fired")
  // Meta click identifiers captured from the buyer's browser at checkout, forwarded
  // to the CAPI Purchase event as un-hashed match keys (fbp = browser id cookie,
  // fbc = click id from the _fbc cookie / fbclid). Nullable: only set for orders
  // placed through the hosted checkout with a Facebook Pixel configured.
  fbp                String?             @map("fbp")
  fbc                String?             @map("fbc")
  deliveryAddress    String?             @map("delivery_address")
  deliveryState      String?             @map("delivery_state")
  deliveryArea       String?             @map("delivery_area")
  estimatedDelivery  DateTime?           @map("estimated_delivery")
  priority           Int                 @default(0)
  tags               String[]            @default([])
  source             String              @default("manual")
  externalOrderId    String?             @map("external_order_id")
  webhookData        Json?               @map("webhook_data")
  webhookFingerprint String?             @unique @map("webhook_fingerprint")
  createdById        Int?                @map("created_by_id")
  // True when COD is off for the customer and the order needs a manual call first (F-317, F-357).
  requiresManualCall Boolean             @default(false) @map("requires_manual_call")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  commissionPaid     Boolean             @default(false) @map("commission_paid")
  payoutId           Int?                @map("payout_id")
  revenueRecognized  Boolean             @default(false) @map("revenue_recognized")
  glJournalEntryId   Int?                @map("gl_journal_entry_id")
  deliveryDate       DateTime?           @map("delivery_date")
  // M1: lifecycle timestamps, set only if empty by the order state machine.
  confirmedAt        DateTime?           @map("confirmed_at")
  confirmedById      Int?                @map("confirmed_by_id")
  dispatchedAt       DateTime?           @map("dispatched_at")
  firstContactAt     DateTime?           @map("first_contact_at")
  returnedAt         DateTime?           @map("returned_at")
  // Optimistic lock. The DB trigger orders_status_version_bump raises it on every status change.
  statusVersion      Int                 @default(0) @map("status_version")
  declineReason      DeclineReason?      @map("decline_reason")
  failureReason      FailureReason?      @map("failure_reason")
  nextAttemptDate    DateTime?           @map("next_attempt_date")
  // Cost of the units at delivery time, set once (F-611). Null until delivered.
  landedCostTotal    Decimal?            @map("landed_cost_total") @db.Decimal(19, 4)
  calls              Call[]
  delivery           Delivery?
  formSubmissions    FormSubmission[]
  orderHistory       OrderHistory[]
  orderItems         OrderItem[]
  createdBy          User?               @relation("OrderCreatedBy", fields: [createdById], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id])
  customerRep        User?               @relation("OrderCustomerRep", fields: [customerRepId], references: [id])
  deliveryAgent      User?               @relation("OrderDeliveryAgent", fields: [deliveryAgentId], references: [id])
  confirmedBy        User?               @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  transaction        Transaction?
  payout             Payout?             @relation(fields: [payoutId], references: [id])
  glJournalEntry     JournalEntry?       @relation(fields: [glJournalEntryId], references: [id])
  agentCollection    AgentCollection?
  inventoryTransfers InventoryTransfer[]
  deliveryAttempts   DeliveryAttempt[]
  messageLogs        MessageLog[]
  downloadTokens     DownloadToken[]
  tenantId           String?             @map("tenant_id")
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Settlement resolves an order by its Paystack reference; scope uniqueness to the
  // tenant so a cross-account reference collision can never map to another tenant's
  // order (NULL payment_reference rows — COD — are exempt: Postgres treats NULLs as
  // distinct in a unique index).
  @@unique([tenantId, paymentReference])
  @@index([customerId])
  @@index([status])
  @@index([customerRepId])
  @@index([deliveryAgentId])
  @@index([createdAt])
  @@index([deliveryArea])
  @@index([status, createdAt])
  @@index([paymentStatus, status])
  @@index([deliveryArea, status])
  @@index([deliveryAgentId, status])
  @@index([customerRepId, status])
  @@index([source])
  @@index([customerId, createdAt])
  @@index([deliveryState, deliveryArea])
  @@index([deletedAt])
  @@index([deletedAt, status])
  @@index([deletedAt, customerId])
  @@index([revenueRecognized])
  @@index([glJournalEntryId])
  @@index([status, deliveryDate])
  @@index([orderType])
  @@index([tenantId])
  @@index([tenantId, confirmedAt])
  @@index([tenantId, dispatchedAt])
  @@index([tenantId, status, deliveryDate])
  @@index([tenantId, deliveryDate])
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  productId  Int      @map("product_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(19, 4)
  totalPrice Decimal  @map("total_price") @db.Decimal(19, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  itemType   String   @default("package") @map("item_type")
  metadata   Json?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  status     OrderStatus
  notes      String?
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")
  changedBy  Int?         @map("changed_by")
  fromStatus OrderStatus? @map("from_status")
  actorKind  ActorKind?   @map("actor_kind")
  forced     Boolean      @default(false)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId   String       @map("tenant_id")
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([orderId])
  @@index([createdAt])
  @@map("order_history")
}

model Delivery {
  id                 Int                @id @default(autoincrement())
  orderId            Int                @unique @map("order_id")
  agentId            Int?               @map("agent_id")
  scheduledTime      DateTime?          @map("scheduled_time")
  actualDeliveryTime DateTime?          @map("actual_delivery_time")
  proofType          DeliveryProofType? @map("proof_type")
  proofData          String?            @map("proof_data")
  proofImageUrl      String?            @map("proof_image_url")
  recipientName      String?            @map("recipient_name")
  recipientPhone     String?            @map("recipient_phone")
  notes              String?
  deliveryAttempts   Int                @default(0) @map("delivery_attempts")
  route              Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  agent              User?              @relation(fields: [agentId], references: [id])
  order              Order              @relation(fields: [orderId], references: [id])
  tenantId           String?            @map("tenant_id")
  tenant             Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agentId])
  @@index([scheduledTime])
  @@index([agentId, scheduledTime])
  @@index([orderId, actualDeliveryTime])
  @@index([scheduledTime, actualDeliveryTime])
  @@index([tenantId])
  @@map("deliveries")
}

model Transaction {
  id                Int           @id @default(autoincrement())
  orderId           Int?          @unique @map("order_id")
  type              String
  amount            Decimal       @db.Decimal(19, 4)
  paymentMethod     String        @map("payment_method")
  status            PaymentStatus @default(pending)
  reference         String?
  description       String?
  metadata          Json?
  // Online payments (F-406): which provider took the money and what it charged.
  provider          String?
  channel           String?
  currency          String?
  feeAmount         Decimal?      @map("fee_amount") @db.Decimal(19, 4)
  feeUnknown        Boolean       @default(false) @map("fee_unknown")
  providerReference String?       @map("provider_reference")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  tenantId          String?       @map("tenant_id")
  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order             Order?        @relation(fields: [orderId], references: [id])

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([type, status])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("transactions")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  amount      Decimal  @db.Decimal(19, 4)
  description String
  receiptUrl  String?  @map("receipt_url")
  recordedBy  Int?     @map("recorded_by")
  expenseDate DateTime @map("expense_date")
  createdAt   DateTime @default(now()) @map("created_at")
  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User?    @relation(fields: [recordedBy], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@index([tenantId])
  @@map("expenses")
}

model Account {
  id             Int                  @id @default(autoincrement())
  code           String
  name           String
  description    String?
  accountType    AccountType          @map("account_type")
  normalBalance  NormalBalance        @map("normal_balance")
  parentId       Int?                 @map("parent_id")
  isSystem       Boolean              @default(false) @map("is_system")
  isActive       Boolean              @default(true) @map("is_active")
  currentBalance Decimal              @default(0) @map("current_balance") @db.Decimal(19, 4)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  parent         Account?             @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]            @relation("AccountHierarchy")
  transactions   AccountTransaction[]
  tenantId       String?              @map("tenant_id")
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([accountType])
  @@index([isActive])
  @@index([parentId])
  @@index([code])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id               Int               @id @default(autoincrement())
  entryNumber      String            @map("entry_number")
  entryDate        DateTime          @map("entry_date")
  description      String
  sourceType       JournalSourceType @map("source_type")
  sourceId         Int?              @map("source_id")
  isVoided         Boolean           @default(false) @map("is_voided")
  voidedAt         DateTime?         @map("voided_at")
  voidedBy         Int?              @map("voided_by")
  voidReason       String?           @map("void_reason")
  // Outside id of the thing that caused the entry, e.g. a Paystack payout reference (F-934). One per tenant and source type.
  externalRef      String?           @map("external_ref")
  reversingEntryId Int?              @unique @map("reversing_entry_id")
  createdBy        Int               @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  transactions   AccountTransaction[]
  reversedBy     JournalEntry?        @relation("ReversalRelation", fields: [reversingEntryId], references: [id])
  reverses       JournalEntry?        @relation("ReversalRelation")
  creator        User                 @relation("JournalEntryCreator", fields: [createdBy], references: [id])
  voider         User?                @relation("VoidedByUser", fields: [voidedBy], references: [id])
  orders         Order[]
  shipments      InventoryShipment[]
  claimShipments InventoryShipment[]  @relation("ShipmentClaimEntry")
  tenantId       String?              @map("tenant_id")
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, entryNumber])
  @@unique([tenantId, sourceType, externalRef])
  @@index([sourceType, sourceId])
  @@index([entryDate])
  @@index([createdAt])
  @@index([isVoided])
  @@index([sourceType, sourceId, isVoided])
  @@index([tenantId])
  @@map("journal_entries")
}

model AccountTransaction {
  id             Int      @id @default(autoincrement())
  journalEntryId Int      @map("journal_entry_id")
  accountId      Int      @map("account_id")
  debitAmount    Decimal  @default(0) @map("debit_amount") @db.Decimal(19, 4)
  creditAmount   Decimal  @default(0) @map("credit_amount") @db.Decimal(19, 4)
  runningBalance Decimal  @default(0) @map("running_balance") @db.Decimal(19, 4)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  // Required: a NULL tenant makes the row invisible to tenant-scoped financial
  // reporting (revenue silently vanishes). Backfilled from the parent journal
  // entry and locked NOT NULL by migration 20260630070000.
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([tenantId])
  @@map("account_transactions")
}

