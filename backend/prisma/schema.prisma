  @@index([tenantId])
  @@index([locationId, countDate])
  @@index([countedById])
  @@index([shipmentId])
  @@map("stock_counts")
}

/// One product in a count. systemQuantity is frozen at count start; difference = countedQuantity - systemQuantity.
/// findingId is the stock_gap Finding a gap opens; appliedMovementId is the count_adjustment movement written by "Apply count".
model StockCountLine {
  id                Int                @id @default(autoincrement())
  countId           Int                @map("count_id")
  productId         Int                @map("product_id")
  systemQuantity    Int                @map("system_quantity")
  countedQuantity   Int                @map("counted_quantity")
  difference        Int
  findingId         Int?               @map("finding_id")
  appliedMovementId Int?               @map("applied_movement_id")
  tenantId          String             @map("tenant_id")
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  count             StockCount         @relation(fields: [countId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  finding           Finding?           @relation(fields: [findingId], references: [id])
  appliedMovement   InventoryTransfer? @relation(fields: [appliedMovementId], references: [id])

  @@unique([countId, productId])
  @@index([tenantId])
  @@index([productId])
  @@index([findingId])
  @@index([appliedMovementId])
  @@map("stock_count_lines")
}

