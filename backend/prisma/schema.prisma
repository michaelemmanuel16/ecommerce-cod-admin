}

// A bulk email send (Salesgee-style "compose → audience → send → history").
// Tenant-scoped. `subject`/`body` are the resolved, sanitized snapshot used for the
// whole send, so the campaign is reproducible even if its source EmailTemplate later
// changes. The denominator fields capture the eligibility breakdown at send time
// (audience → no-email → opted-out → emailable) so the history detail is a pure read;
// live sent/delivered/failed/skipped counts come from aggregating MessageLog by
// campaignId. Email never sends on its own — only an explicit bulk Send enqueues jobs.
enum EmailCampaignStatus {
  queued
  sending
  completed
}

model EmailCampaign {
  id              Int                 @id @default(autoincrement())
  title           String
  subject         String
  body            String
  status          EmailCampaignStatus @default(queued)
  audienceTotal   Int                 @default(0) @map("audience_total")
  noEmailCount    Int                 @default(0) @map("no_email_count")
  optedOutCount   Int                 @default(0) @map("opted_out_count")
  totalRecipients Int                 @default(0) @map("total_recipients")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messageLogs MessageLog[]

  @@index([tenantId])
  @@map("email_campaigns")
}

